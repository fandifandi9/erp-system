# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Legacy Capacitor shell (mobile resmi = Expo di folder mobile/)
/android/

# production
/build

# misc
.DS_Store
*.pem
/data/unboxing-videos/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.staging
.env.staging.local

# PocketBase data / local DB (never commit production or staging data)
pb_data/
**/pb_data/
*.db
*.db-shm
*.db-wal
backups/
**/backups/
storage/
**/storage/

# Staging deploy local overrides (secrets)
deploy/staging/*.local

# Local PocketBase binary (downloaded; never production/staging)
tools/local-pb/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
