# Resend — https://resend.com

RESEND_API_KEY=re_xxxxxxxx

RESEND_FROM_EMAIL=onboarding@resend.dev

RESEND_FROM_NAME=SERBA ERP



# Reset password (min. 16 karakter acak)

PASSWORD_RESET_SECRET=change-me-to-a-long-random-secret



# Video unboxing WMS — disimpan di HDD lokal PC (bukan cloud)
# Dev (hanya drive C): path di bawah project atau folder user
