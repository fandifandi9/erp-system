{
  "cli": {
    "version": ">= 19.0.8",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_PB_DISABLE_REALTIME": "true",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "4645bf17-9b30-440a-bebb-8f4c73ce1105"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ERP_WEB_URL": "http://localhost:3000"
      }
    },
    "staging": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://pb-staging.serba.space",
        "EXPO_PUBLIC_ERP_WEB_URL": "https://staging.serba.space",
        "EXPO_PUBLIC_PB_DISABLE_REALTIME": "true"
      }
    },
    "preview": {
      "extends": "staging"
    },
    "preview-apk": {
      "extends": "preview",
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://pb.serba.space",
        "EXPO_PUBLIC_ERP_WEB_URL": "https://serba.space",
        "EXPO_PUBLIC_PB_DISABLE_REALTIME": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
