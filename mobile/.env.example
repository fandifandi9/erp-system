# Copy to mobile/.env and keep exactly ONE environment active.
# Never put passwords or admin tokens in this file.

# --- Development (Expo + Next on the same machine) ---
# For Android physical device on the same Wi‑Fi, use your PC LAN IP (not localhost):
#   EXPO_PUBLIC_ERP_WEB_URL=http://192.168.x.x:3000
#   EXPO_PUBLIC_POCKETBASE_URL=http://192.168.x.x:8090
# For Android emulator: EXPO_PUBLIC_ERP_WEB_URL=http://10.0.2.2:3000
# EXPO_PUBLIC_ERP_WEB_URL=http://localhost:3000
# EXPO_PUBLIC_POCKETBASE_URL=
# Set local PocketBase URL in .env (not committed). Do not use 127.0.0.1:8090 in release builds.

# --- Staging (UAT — default for this example) ---
EXPO_PUBLIC_ERP_WEB_URL=https://staging.serba.space
EXPO_PUBLIC_POCKETBASE_URL=https://pb-staging.serba.space

# --- Production (EAS profile `production` only; do not use while testing staging) ---
# EXPO_PUBLIC_ERP_WEB_URL=https://serba.space
# EXPO_PUBLIC_POCKETBASE_URL=https://pb.serba.space

EXPO_PUBLIC_PB_DISABLE_REALTIME=true
# EXPO_PUBLIC_PB_SESSION_POLL_MS=30000
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
