# PocketBase HTTPS URL (same server as ERP web). No trailing slash.
# — Dev lokal: salin ke `.env` (file ini tidak di-commit).
# — EAS Build APK: URL di `eas.json` → profil `base` → `env` (wajib diubah jika ganti domain).
EXPO_PUBLIC_POCKETBASE_URL=https://pb.serba.space

# URL ERP web (Next.js) — untuk API inventory (/api/inventory/*).
EXPO_PUBLIC_ERP_WEB_URL=https://serba.space

# Disarankan true di APK produksi (hindari crash / putus SSE di jaringan operator).
EXPO_PUBLIC_PB_DISABLE_REALTIME=true
# EXPO_PUBLIC_PB_SESSION_POLL_MS=30000

# Optional — Expo push token (EAS). See https://docs.expo.dev/push-notifications/push-notifications-setup/
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
