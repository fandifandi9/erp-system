# PocketBase

NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# --- Staging PocketBase (Wave 2B) — NEVER use pb.serba.space / port 8091 ---
# Prefer gitignored .env.staging.local (see deploy/staging/README-STAGING.md).
# Tunnel: ssh -L 8092:127.0.0.1:8092 <user>@<vps>
# POCKETBASE_STAGING_URL=http://127.0.0.1:8092
# POCKETBASE_STAGING_ADMIN_EMAIL=staging-admin@example.com
# POCKETBASE_STAGING_ADMIN_PASSWORD="staging-only-password-not-production"
# STAGING_SEED_PASSWORD="staging-fixture-password-unique"
# STAGING_SEED_INCLUDE_COMPANY_B=1
# STAGING_EMAIL_DOMAIN=staging.serba.test
# STAGING_EXPECT_MODE=baseline
# After write-lock: STAGING_EXPECT_MODE=locked

# Wajib untuk posting stok inventory (admin PocketBase / superuser)
# Server-only — NEVER prefix with NEXT_PUBLIC_

POCKETBASE_ADMIN_EMAIL=admin@example.com

# Wajib pakai tanda kutip jika ada @ # $ spasi

POCKETBASE_ADMIN_PASSWORD="your-admin-password"



# URL publik ERP (link di email ke pelanggan/supplier)

# URL publik ERP (sama dengan yang dibuka user, termasuk www jika dipakai)
NEXT_PUBLIC_APP_URL=https://www.serba.space



# Resend — https://resend.com

RESEND_API_KEY=re_xxxxxxxx

RESEND_FROM_EMAIL=onboarding@resend.dev

RESEND_FROM_NAME=SERBA ERP



# Smoke test E2E (npm run smoke:test)
# SMOKE_PASSWORD=your-shared-test-password
# SMOKE_APP_URL=http://localhost:3000

PASSWORD_RESET_SECRET=change-me-to-a-long-random-secret



# Video unboxing WMS — disimpan di HDD lokal PC (bukan cloud)
# Dev: path absolut di bawah project ini (ubah jika folder project berbeda)
LOCAL_UNBOXING_VIDEO_DIR=B:\Coding\erp-system\data\unboxing-videos
# Atau relatif dari root project: ./data/unboxing-videos
# Production (contoh drive terpisah): D:\SERBA\unboxing-videos

